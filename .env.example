NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/crm_portal

# JWT Configuration - Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_change_this_min_64_characters
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Super Admin Credentials (used by seed.js)
SUPERADMIN_EMAIL=admin@dsamentor.com
SUPERADMIN_PASSWORD=SuperAdmin@123
SUPERADMIN_USERNAME=admin

# CORS
CLIENT_URL=http://localhost:3000

# Production URL (add your production frontend URL here)
PRODUCTION_URL=https://your-production-domain.com

# For Production (MongoDB Atlas):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/crm_portal?retryWrites=true&w=majority
